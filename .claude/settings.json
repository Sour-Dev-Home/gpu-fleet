    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.pem)",
      "Read(./.private-patterns.txt)",
      "Read(./**/keys.txt)"
    ]
  }
}
